@model dynamic

@functions {
    private string GetPageUrl(int page)
    {
        var query = new Dictionary<string, string>();

        foreach (var key in Context.Request.Query.Keys)
        {
            if (key.ToLower() != "page")
            {
                query[key] = Context.Request.Query[key];
            }
        }

        query["page"] = page.ToString();

        var queryString = string.Join("&", query.Select(kvp => $"{kvp.Key}={kvp.Value}"));
        return $"?{queryString}";
    }
}

@if (Model.TotalPages > 1)
{
    <nav aria-label="Pagination">
        <ul class="pagination justify-content-center mt-3">

            <!-- Nút Previous -->
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="@GetPageUrl(Model.CurrentPage - 1)" aria-label="Previous">&laquo;</a>
            </li>

            @if (Model.TotalPages <= 5)
            {
                <!-- Nếu tổng số trang <= 5: hiển thị tất cả -->
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@GetPageUrl(i)">@i</a>
                    </li>
                }
            }
            else
            {
                @if (Model.CurrentPage <= 3)
                {
                    <!-- Trường hợp CurrentPage <= 3: 1,2,3,4,...,last -->
                    @for (int i = 1; i <= 4; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@GetPageUrl(i)">@i</a>
                        </li>
                    }

                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="@GetPageUrl(Model.TotalPages)">@Model.TotalPages</a>
                    </li>
                }
                else if (Model.CurrentPage >= Model.TotalPages - 2)
                {
                    <!-- Trường hợp CurrentPage >= TotalPages - 2: 1,...,last-3,last-2,last-1,last -->
                    <li class="page-item">
                        <a class="page-link" href="@GetPageUrl(1)">1</a>
                    </li>

                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>

                    @for (int i = Model.TotalPages - 3; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@GetPageUrl(i)">@i</a>
                        </li>
                    }
                }
                else
                {
                    <!-- Trường hợp ở giữa: 1,...,curr-1,curr,curr+1,...,last -->
                    <li class="page-item">
                        <a class="page-link" href="@GetPageUrl(1)">1</a>
                    </li>

                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>

                    @for (int i = Model.CurrentPage - 1; i <= Model.CurrentPage + 1; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@GetPageUrl(i)">@i</a>
                        </li>
                    }

                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>

                    <li class="page-item">
                        <a class="page-link" href="@GetPageUrl(Model.TotalPages)">@Model.TotalPages</a>
                    </li>
                }
            }

            <!-- Nút Next -->
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@GetPageUrl(Model.CurrentPage + 1)" aria-label="Next">&raquo;</a>
            </li>
        </ul>
    </nav>
}